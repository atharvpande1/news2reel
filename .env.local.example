# Copy to .env.local. Read by both containers in local development.
POSTGRES_USER=news2reel
POSTGRES_PASSWORD=news2reel
POSTGRES_DB=news2reel

FEEDCAST_DATABASE_URL=postgresql+asyncpg://news2reel:news2reel@db:5432/news2reel
# pytest creates, empties and reuses this database — never point it at the one above.
FEEDCAST_TEST_DATABASE_URL=postgresql+asyncpg://news2reel:news2reel@db:5432/feedcast_test

FEEDCAST_LLM_API_KEY=

# Auth. Local runs over plain http, where a Secure cookie is never sent back.
# Required, 32+ characters — startup refuses anything shorter, including empty:
# python -c "import secrets;print(secrets.token_urlsafe(48))"
FEEDCAST_JWT_SECRET=
FEEDCAST_COOKIE_SECURE=false

# Interactive API docs at /docs — local only.
FEEDCAST_API_DOCS=true

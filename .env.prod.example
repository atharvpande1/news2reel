# Copy to .env.prod on the host. Read by both containers in production.
POSTGRES_USER=news2reel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=news2reel

# Same password as POSTGRES_PASSWORD.
FEEDCAST_DATABASE_URL=postgresql+asyncpg://news2reel:change-me@db:5432/news2reel

FEEDCAST_LLM_API_KEY=
# Required, 32+ characters: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating it logs every editor out. Cookies are Secure by default here.
FEEDCAST_JWT_SECRET=change-me
